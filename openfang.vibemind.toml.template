# ═══════════════════════════════════════════════════════════════════
# Desktop Automation (handoff multi-agent system)
# ═══════════════════════════════════════════════════════════════════
# Exposes the eyeTerm/handoff toolset (handoff_action, handoff_describe_screen,
# handoff_excel_*, etc.) to any agent that connects to OpenFang. Replaces the
# previous per-agent stdio entry (e.g. OpenClaw's acpx config) so all
# consumers — OpenClaw ACP sessions, coding-engine, brain — share one
# warm process instead of paying the SentenceTransformer/Torch cold-start
# 10–30 s per agent.
[[mcp_servers]]
name = "desktop-automation"
# 300s so handoff_approval_request can block up to ~240s, plus headroom
# for slow gpt-5.5 coordinator iterations on big tool-loops. Bumped
# 180->300 (2026-05-08) — smart-skill loops were aborting with
# "MCP-Tool-Timeout" because the 180s ceiling was too tight.
timeout_secs = 300
[mcp_servers.transport]
type = "stdio"
command = "python"
args = ["${VIBEMIND_ROOT}/vibemind-os/spaces/desktop/Automation_ui/backend/moire_agents/mcp_server_handoff.py"]

