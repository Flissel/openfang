# OpenFang — VibeMind Integration Config
# Merged with ~/.openfang/config.toml at startup.
#
# This config enables:
# - Brain (Tahlamus) as MCP server for cognitive state queries
# - A2A protocol for inter-service task routing
# - 30+ MCP servers for agent tooling

# API server port (top-level field, NOT under [network])
api_listen = "127.0.0.1:4200"

# ── Telegram Channel ─────────────────────────────────────────────
# Enables polling for the @VibeMind_agent_bot bot. Without this block
# OpenFang starts without a Telegram consumer and incoming messages pile
# up as pending updates on Telegram's servers.
[channels.telegram]
bot_token_env = "TELEGRAM_BOT_TOKEN"
allowed_users = ["1092040975"]
# Telegram routes to the dedicated `desktop` agent which has an MCP
# allowlist of only the desktop-automation server (~20 tools, not 368).
# This avoids the 60s heartbeat timeout caused by 368-tool tool-loops
# and keeps replies focused on what the user actually wants from the bot.
default_agent = "desktop"

[default_model]
provider = "claude-code"
model = "claude-code/sonnet"

# ── Brain MCP Server ────────────────────────────────────────────
# Gives agents access to cognitive state via SSE
[[mcp_servers]]
name = "brain"
timeout_secs = 5
[mcp_servers.transport]
type = "sse"
url = "http://localhost:8900"

# ── Self-Healing Loop ────────────────────────────────────────────
[[mcp_servers]]
name = "issue-detector"
timeout_secs = 30
[mcp_servers.transport]
type = "stdio"
command = "python"
args = ["${VIBEMIND_ROOT}/vibemind-os/issue-detector/mcp_server.py"]

