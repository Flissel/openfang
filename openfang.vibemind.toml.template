# ═══════════════════════════════════════════════════════════════════
# Phase 11.B — Multiverse Navigation (Smart 3-layer resolver)
# Maps natural-language queries to one of 14 spaces and broadcasts
# navigation events to the Electron UI. Layers: alias → Qwen3 embedding
# → LLM tiebreaker.
# ═══════════════════════════════════════════════════════════════════

[[mcp_servers]]
name = "space-navigator"
timeout_secs = 30
[mcp_servers.transport]
type = "stdio"
command = "python"
args = ["${VIBEMIND_ROOT}/vibemind-os/spaces/_navigator/mcp_server.py"]
env = { OPENROUTER_API_KEY = "${OPENROUTER_API_KEY}", NAVIGATOR_LLM_MODEL = "openai/gpt-4o-mini", NAVIGATOR_EMBED_MODEL = "Qwen/Qwen3-Embedding-0.6B" }

# ═══════════════════════════════════════════════════════════════════
# A2A Protocol
# ═══════════════════════════════════════════════════════════════════

[a2a]
enabled = true
listen_path = "/a2a"

[[a2a.external_agents]]
name = "brain-bridge"
url = "http://localhost:5100"
